    orcid: "https://orcid.org/0009-0000-6891-1562"
repository-code: "https://github.com/Antonio-Tresol/gemma4-emotion-vectors"
license: MIT
keywords:
  - emotion vectors
  - activation steering
  - circumplex model
  - Gemma
  - AI safety
  - mechanistic interpretability
