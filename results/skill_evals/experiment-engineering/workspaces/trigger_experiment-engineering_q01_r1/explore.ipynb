   "source": [
    "import json, statistics\n",
    "rows = [json.loads(l) for l in open('results/scores.jsonl')]\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "metadata": {},
   "outputs": [],
   "source": [
    "# scoring cell\n",
    "def score(row):\n",
    "    return row['correct'] / max(row['total'], 1)\n",
    "scores = [score(r) for r in rows]\n",
    "print(statistics.mean(scores))\n"
   ]
  }
 ],
